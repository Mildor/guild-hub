# ─── Stage 1 : Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

# Activer corepack pour pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copier uniquement les manifestes pour profiter du cache des couches
COPY package.json pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

# Copier le reste du code source
COPY . .

# La VITE_API_URL est injectée au build via --build-arg dans docker-compose
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

RUN pnpm run build

# ─── Stage 2 : Serve (Nginx) ───────────────────────────────────────────────────
FROM nginx:alpine

# Copier le dist généré vers le répertoire servi par Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Copier la config Nginx personnalisée (SPA fallback + gzip + cache)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
