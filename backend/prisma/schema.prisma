// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  ADMIN
  OFFICER
  MEMBER
  GUEST
}

enum GameRole {
  TANK
  HEALER
  DPS
}

enum AttendanceStatus {
  ACCEPTED
  DECLINED
  TENTATIVE
  LATE
}

enum SharedProfile {
  A
  B
  C
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  bnetId          Int      @unique
  battletag       String
  bnetAccessToken String?
  discordId       String?
  isSharedAccount Boolean  @default(false)
  appRole    AppRole  @default(GUEST)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  characters Character[]
  events     Event[]
  attendances Attendance[]
  strategies Strategy[]
  polls      Poll[]
  pollVotes  PollVote[]
}

model Character {
  id         String   @id @default(uuid()) @db.Uuid
  blizzardId Int?     @unique
  userId     String   @db.Uuid
  name       String
  realm      String
  class      String
  activeSpec String
  gameRole   GameRole
  ilvl       Float    @default(0)
  isMain     Boolean  @default(false)
  inRoster   Boolean  @default(false)
  sharedProfile SharedProfile?
  guildRank  Int?
  lastSyncAt DateTime @default(now())

  // Photos
  avatarUrl  String?
  renderUrl  String?
  insetUrl   String?

  // Spécialisation détails
  activeSpecName String?
  activeSpecIcon String?

  // Équipement complet
  equipment  Json?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  professions CharacterProfession[]

  @@unique([userId, name, realm])
}

model CharacterProfession {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @db.Uuid
  profession  String
  skillLevel  Int
  recipes     Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, profession])
  @@index([profession])
}

model Event {
  id                    String   @id @default(uuid()) @db.Uuid
  title                 String
  description           String
  eventDate             DateTime
  createdById           String   @db.Uuid
  reminderSent1Day      Boolean  @default(false)
  reminderSent3Hours    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attendances Attendance[]
}

model Attendance {
  eventId     String   @db.Uuid
  userId      String   @db.Uuid
  characterId String?  @db.Uuid
  status      AttendanceStatus

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@id([eventId, userId])
}

model Strategy {
  id                  String   @id @default(uuid()) @db.Uuid
  bossName            String
  raidName            String
  positioningImageUrl String?
  generalMechanics    String   @db.Text
  tankNotes           String?  @db.Text
  healerNotes         String?  @db.Text
  dpsNotes            String?  @db.Text
  createdById         String   @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdBy           User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  @@unique([raidName, bossName])
}

model Poll {
  id          String       @id @default(uuid()) @db.Uuid
  question    String
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  isActive    Boolean      @default(true)
  allowMultipleSelections Boolean @default(false)
  createdById String       @db.Uuid
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  options     PollOption[]
  votes       PollVote[]
}

model PollOption {
  id      String     @id @default(uuid()) @db.Uuid
  pollId  String     @db.Uuid
  text    String
  poll    Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes   PollVote[]
}

model PollVote {
  id        String     @id @default(uuid()) @db.Uuid
  pollId    String     @db.Uuid
  optionId  String     @db.Uuid
  userId    String     @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId, userId])
}

model WowTokenPrice {
  id        String   @id @default(uuid()) @db.Uuid
  price     Int
  createdAt DateTime @default(now())
}

model FailedLoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  identifier String?
  ipAddress  String?
  userAgent  String?
  reason     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([provider])
}
